# Backend Environment Variables (Example)
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file!

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=buzzcart_dev

# CORS Configuration
# For dev: use your frontend URL
# For prod: use your production domain
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# JWT Secret (CHANGE THIS!)
# Generate a secure random string for production
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# Emergent LLM API Key
# Get your key from https://emergent.ai
EMERGENT_LLM_KEY=

# Environment
NODE_ENV=development

# Optional: Additional API keys
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
