# Database Configuration
POSTGRES_USER=like2share_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=like2share_db
DATABASE_URL=postgres://like2share_user:your_secure_password_here@localhost:5432/like2share_db?sslmode=disable

# Backend Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
PORT=8080
ENV=development

# Storage Configuration
MEDIA_STORAGE_PATH=./storage/media
MEDIA_BASE_URL=http://localhost/media
STORAGE_TYPE=local  # Options: local, s3, azure, gcs

# File Size Limits (in bytes)
MAX_FILE_SIZE=104857600        # 100MB
MAX_IMAGE_SIZE=10485760        # 10MB
MAX_VIDEO_SIZE=104857600       # 100MB
MAX_PROFILE_PIC_SIZE=2097152   # 2MB

# Allowed file types
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,webm,mov

# Thumbnail settings
THUMBNAIL_SMALL_SIZE=150
THUMBNAIL_MEDIUM_SIZE=300
THUMBNAIL_LARGE_SIZE=600
THUMBNAIL_QUALITY=85

# Video processing
ENABLE_VIDEO_PROCESSING=true
VIDEO_MAX_DURATION=300         # 5 minutes in seconds
VIDEO_TRANSCODE_FORMAT=mp4

# Cleanup
TEMP_FILE_RETENTION_HOURS=24
AUTO_CLEANUP_ENABLED=true

# Storage quotas per user
USER_STORAGE_QUOTA=5368709120  # 5GB in bytes
USER_MAX_FILES=1000

# Frontend Configuration
API_URL=http://localhost:8080

# Chatbot / RAG Configuration
OLLAMA_MODEL=mistral
CHATBOT_URL=http://localhost:8000
DOCUMENT_URL_REWRITE_FROM=["localhost","127.0.0.1","10.0.2.2"]
DOCUMENT_URL_REWRITE_TO=minio:9000

# Cloud Storage (Optional - for production)
# AWS S3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=like2share-media
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_CLOUDFRONT_DOMAIN=your_cdn_domain

# Azure Blob Storage
# AZURE_STORAGE_ACCOUNT=like2share
# AZURE_STORAGE_KEY=your_key
# AZURE_STORAGE_CONTAINER=media
# AZURE_CDN_ENDPOINT=your_cdn_endpoint

# Google Cloud Storage
# GCP_PROJECT_ID=like2share
# GCP_BUCKET_NAME=like2share-media
# GCP_SERVICE_ACCOUNT_KEY=/path/to/key.json
# GCP_CDN_URL=your_cdn_url

# Production Settings (for docker-compose.prod.yml)
# POSTGRES_PASSWORD=your_production_password
# JWT_SECRET=your_production_jwt_secret
