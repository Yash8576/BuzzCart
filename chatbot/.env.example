# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database
VECTOR_DB_TYPE=chroma  # chroma, pinecone, qdrant
CHROMA_PERSIST_DIR=/app/data/embeddings
CHROMA_COLLECTION_NAME=like2share_knowledge

# PostgreSQL (for chat history)
DATABASE_URL=postgresql://user:password@postgres:5432/like2share
# Firebase Cloud SQL via Auth Proxy example (recommended local setup)
# DATABASE_URL=postgresql://buzzcart_chatbot_ro:REPLACE_CHATBOT_PASSWORD@127.0.0.1:5432/buzzcart-daeb6-database?sslmode=disable
CHAT_HISTORY_TABLE=chat_messages

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
TEMPERATURE=0.7
MAX_TOKENS=500

# Document Storage
DOCUMENTS_PATH=/app/data/documents
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx,.html

# Redis (for caching)
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# Backend Integration
BACKEND_API_URL=http://backend:8080
BACKEND_API_KEY=your_backend_api_key
